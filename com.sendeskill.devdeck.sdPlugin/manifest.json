{
	"Name": "Sendeskill Dev Deck",
	"Version": "0.1.0.0",
	"Author": "Lucas Sendeski",
	"Actions": [
		{
			"Name": "Próxima reunião",
			"UUID": "com.sendeskill.devdeck.next-meeting",
			"Icon": "imgs/actions/meeting/icon",
			"Tooltip": "Mostra a próxima reunião do calendário ICS. Pisca em vermelho nos 10 minutos antes. Ao apertar, abre o Outlook.",
