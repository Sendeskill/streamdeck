			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/meeting/key", "ShowTitle": false }],
			"UserTitleEnabled": false
		},
		{
			"Name": "Claude terminou",
			"UUID": "com.sendeskill.devdeck.claude-done",
			"Icon": "imgs/actions/claude/icon",
			"Tooltip": "Pisca quando o Claude Code termina; ao clicar abre o VS Code no projeto.",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "imgs/actions/claude/key", "ShowTitle": false }],
			"UserTitleEnabled": false
		}
	],
	"Category": "Sendeskill",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
